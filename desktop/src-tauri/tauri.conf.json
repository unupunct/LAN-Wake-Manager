{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LAN Wake Manager",
  "version": "1.0.0",
  "identifier": "io.github.unupunct.lanwakemanager",
  "build": { "frontendDist": "../loading" },
  "app": {
    "windows": [
      { "label": "main", "title": "LAN Wake Manager", "width": 1360, "height": 860, "minWidth": 900, "minHeight": 600, "center": true, "backgroundColor": "#101215" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Wake, shut down and restart your computers from anywhere",
    "longDescription": "Desktop window of LAN Wake Manager: manage computers, schedules and mobile access."
  }
}
