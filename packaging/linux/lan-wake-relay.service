[Unit]
Description=LAN Wake Manager Relay
Documentation=https://github.com/unupunct/LAN-Wake-Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/lwm-relay service
Restart=always
RestartSec=5
# Sends Wake-on-LAN packets inside this LAN for LAN Wake Manager

[Install]
WantedBy=multi-user.target
