<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util" xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <!-- Wake Relay: install on an always-on computer inside a LAN. After setup run `lwm-relay pair-code` in an administrator terminal. -->
  <Package Name="LAN Wake Manager Relay" Manufacturer="unupunct" Version="$(var.Version)" Language="1033"
           UpgradeCode="4BFC9D44-50D9-4618-A0C8-80840185242F" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of the LAN Wake Manager Relay is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="AppIcon.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Launch Condition="Installed OR VersionNT64" Message="Requires 64-bit Windows 10 or 11." />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="LAN Wake Manager Relay" />
    </StandardDirectory>
    <Feature Id="Main" Title="Wake Relay" Level="1" AllowAbsent="no">
      <ComponentRef Id="RelayExe" />
      <ComponentRef Id="RelayPath" />
    </Feature>
    <Component Id="RelayExe" Directory="INSTALLFOLDER" Guid="*">
      <File Id="RelayFile" Source="$(var.StageDir)\lwm-relay.exe" KeyPath="yes" />
      <ServiceInstall Id="RelaySvc" Name="LANWakeRelay" DisplayName="LAN Wake Manager Relay"
                      Description="Sends Wake-on-LAN packets inside this LAN for LAN Wake Manager and verifies that computers come up."
                      Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Arguments="service" />
      <ServiceControl Id="RelayCtl" Name="LANWakeRelay" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      <util:ServiceConfig ServiceName="LANWakeRelay" FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart" RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
      <fw:FirewallException Id="RelayFw" Name="LAN Wake Manager Relay (TCP 8444)" Port="8444" Protocol="tcp" Scope="any" Profile="all" />
    </Component>
    <Component Id="RelayPath" Directory="INSTALLFOLDER" Guid="*">
      <Environment Id="RelayPathEnv" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" />
      <RegistryValue Root="HKLM" Key="Software\LANWakeManagerRelay" Name="Path" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
  </Package>
</Wix>
